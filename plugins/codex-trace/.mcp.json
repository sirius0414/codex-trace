{
  "mcpServers": {
    "codex-trace": {
      "args": [
        "run",
        "--no-project",
        "--no-config",
        "--python",
        "3.14.2",
        "--with-requirements",
        "./requirements.lock",
        "--",
        "python",
        "-I",
        "-B",
        "./launch.py"
      ],
      "command": "uv",
      "cwd": ".",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUTF8": "1"
      }
    }
  }
}
