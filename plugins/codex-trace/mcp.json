{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "codex-trace": {
      "args": [
        "run",
        "--no-project",
        "--no-config",
        "--python",
        "3.14.2",
        "--with-requirements",
        "./requirements.lock",
        "--",
        "python",
        "-I",
        "-B",
        "./launch.py"
      ],
      "command": "uv",
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "PYTHONDONTWRITEBYTECODE": "1",
        "PYTHONUTF8": "1"
      },
      "type": "stdio"
    }
  }
}
