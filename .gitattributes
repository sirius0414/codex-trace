# Auto detect text files and perform LF normalization
* text=auto

# Preserve exact bytes in synthetic raw-record fixtures.
/tests/fixtures/contracts/unknown-and-partial.bin binary

# Preserve upstream legal text bytes and reproducible notice checksums across platforms.
/third_party/LICENSES/** -text
/third_party/manifest.json text eol=lf
/third_party/THIRD_PARTY_NOTICES.txt text eol=lf

# Generated distribution files carry byte hashes and must survive Windows checkout unchanged.
/plugins/codex-trace/** -text
/.agents/plugins/marketplace.json text eol=lf

# Generated upstream license copies remain byte-exact; review their recorded hashes.
/plugins/codex-trace/LICENSES/** -diff
