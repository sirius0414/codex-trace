{
  "name": "codex-trace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/bridge/*.test.mjs",
    "dev:browser": "node scripts/run_python.mjs dev_browser.py",
    "dev:browser:start": "node scripts/run_python.mjs manage_dev_browser.py start",
    "dev:browser:stop": "node scripts/run_python.mjs manage_dev_browser.py stop",
    "dev:browser:restart": "node scripts/run_python.mjs manage_dev_browser.py restart",
    "dev:browser:status": "node scripts/run_python.mjs manage_dev_browser.py status",
    "release:build": "node scripts/run_python.mjs build_release.py",
    "marketplace:runtime": "node scripts/run_python.mjs fetch_marketplace_runtime.py",
    "marketplace:build": "node scripts/run_python.mjs build_marketplace.py",
    "marketplace:verify": "node scripts/run_python.mjs smoke_marketplace.py",
    "plugin:update": "node scripts/run_python.mjs update_plugin.py",
    "community:build": "node scripts/run_python.mjs build_community_marketplace.py",
    "community:check": "node scripts/run_python.mjs build_community_marketplace.py --check",
    "community:verify": "node scripts/run_python.mjs smoke_community_marketplace.py"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "highlight.js": "11.11.1",
    "marked": "15.0.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
