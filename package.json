{
  "name": "codex-display",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/bridge/*.test.mjs",
    "dev:browser": "python3 scripts/dev_browser.py",
    "dev:browser:start": "python3 scripts/manage_dev_browser.py start",
    "dev:browser:stop": "python3 scripts/manage_dev_browser.py stop",
    "dev:browser:restart": "python3 scripts/manage_dev_browser.py restart",
    "dev:browser:status": "python3 scripts/manage_dev_browser.py status",
    "plugin:update": "python3 scripts/update_plugin.py"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
